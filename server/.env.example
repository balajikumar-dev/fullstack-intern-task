PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mini_saas_template_store
# Generate a random secret of at least 32 characters; never commit server/.env.
JWT_SECRET=
# Comma-separated frontend origins, without trailing slashes.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Set to 1 only behind exactly one trusted reverse proxy (for example Render).
TRUST_PROXY=0
